# Copy this file to .env and fill in your own values before running the app.

# Don't set a passcode here directly. After copying this file, run:
#   npm run set-passcode
# It will prompt you (hidden input) and write a salted hash below as
# EDIT_PASSCODE_SALT / EDIT_PASSCODE_HASH — the plaintext is never stored.

# Random secret used to sign edit sessions. Change this to any long random string.
SESSION_SECRET=please-change-this-to-a-long-random-string

# Shown in the page header, e.g. "Alex's Availability"
DISPLAY_NAME=My Availability

# Port the local server runs on
PORT=3000
